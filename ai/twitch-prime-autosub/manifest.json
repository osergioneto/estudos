{
    "manifest_version": 3,
    "name": "Auto Twitch Sub",
    "version": "1.0",
    "description": "Renova automaticamente a inscrição de um canal da Twitch usando o sub gratuito do Amazon Prime.",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "storage",
        "alarms",
        "scripting"
    ],
    "host_permissions": [
        "https://*.twitch.tv/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}